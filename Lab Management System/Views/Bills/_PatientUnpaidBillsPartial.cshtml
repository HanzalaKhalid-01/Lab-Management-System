@model IEnumerable<Lab_Management_System.Models.Bill>

<div class="container-fluid">

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center">
            ✅ No pending bills for this patient
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Bill #</th>
                        <th>Tests</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Remaining</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model)
                    {
                        var isCredit = bill.RemainingAmount > 0;
                        <tr class="@(isCredit ? "credit-blink fw-bold" : "")">
                            <td>@bill.BillDate.ToString("dd-MM-yyyy")</td>
                            <td>@bill.BillNumber</td>

                            <td>
                                @(
                                    bill.BillItems != null && bill.BillItems.Any()
                                    ? string.Join(", ", bill.BillItems.Select(x => x.TestNameSnapshot))
                                    : "—"
                                    )
                            </td>

                            <td>Rs @(bill.TotalAmount - bill.DiscountAmount)</td>
                            <td>Rs @bill.PaidAmount.ToString("N0")</td>
                            <td style="color:@(isCredit ? "red;font-weight:bold;" : "green;")">
                                Rs @bill.RemainingAmount.ToString("N0")
                                @(isCredit ? " ⚠️" : " ✅")
                            </td>
                            <td class="text-center">
                                @if (isCredit)
                                {
                                    <div class="gap-2 align-items-stretch">
                                        <input type="number"
                                               id="pay_@bill.BillId"
                                               class="form-control payment form-control-sm"
                                               style="width:90px;"
                                               placeholder="Amount" min="0"/>

                                        <button class="btn btn-sm btn-success"
                                                onclick="receivePayment(@bill.BillId)">
                                            Receive
                                        </button>
                                    </div>
                                }

                                <a asp-action="Print"
                                   asp-route-id="@bill.BillId"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-dark mt-1 w-100">
                                    🖨 Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    /* Highlight blinking for partial credit */
    .credit-blink {
        animation: blinkBg 1.5s infinite;
    }

    @@keyframes blinkBg {
        0% {
            background-color: #ffe5e5;
        }

        50% {
            background-color: #ffcccc;
        }

        100% {
            background-color: #ffe5e5;
        }
    }

    /* Input + button alignment */
    input.form-control-sm {
        display: inline-block;
    }

    button.btn-sm {
        display: inline-block;
    }
</style>