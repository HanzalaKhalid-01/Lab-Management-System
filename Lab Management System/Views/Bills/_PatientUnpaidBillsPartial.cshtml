@model IEnumerable<Lab_Management_System.Models.Bill>

<div class="container-fluid">

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center my-3">
            ✅ No pending bills for this patient
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle w-100 text-center">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Bill #</th>
                        <th>Tests</th>
                        <th>Total (Rs)</th>
                        <th>Paid (Rs)</th>
                        <th>Remaining (Rs)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model)
                    {
                        var isCredit = bill.RemainingAmount > 0;
                        <tr class="@(isCredit ? "credit-row" : "")">
                            <td>@bill.BillDate.ToString("dd-MM-yyyy")</td>
                            <td class="fw-bold">@bill.BillMonth.ToString("D2")-@bill.BillNumber.ToString("D3")</td>
                            <td class="text-start">
                                @(
                                    bill.BillItems != null && bill.BillItems.Any()
                                    ? string.Join(", ", bill.BillItems.Select(x => x.TestNameSnapshot))
                                    : "—"
                                    )
                            </td>
                            <td>@(bill.TotalAmount - bill.DiscountAmount)</td>
                            <td>@bill.PaidAmount.ToString("N0")</td>
                            <td class="fw-bold @(isCredit ? "text-danger" : "text-success")">
                                @bill.RemainingAmount.ToString("N0")
                                @(isCredit ? " ⚠️" : " ✅")
                            </td>
                            <td>
                                @if (isCredit)
                                {
                                    <div class="d-flex gap-2 justify-content-center align-items-center flex-wrap">
                                        <input type="number"
                                               id="pay_@bill.BillId"
                                               class="form-control form-control-sm payment"
                                               style="width:100px;"
                                               placeholder="Amount"
                                               min="1" />
                                        <button class="btn btn-sm btn-success"
                                                onclick="receivePayment(@bill.BillId)">
                                            Receive
                                        </button>
                                    </div>
                                }
                                <a asp-action="Print"
                                   asp-route-id="@bill.BillId"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-dark mt-1 w-100">
                                    Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    /* Credit row highlight with smooth pulse */
    .credit-row {
        border-left: 5px solid #dc2626; /* red alert */
        background-color: rgba(220,38,38,0.08);
        animation: creditPulse 1.6s ease-in-out infinite;
        transition: background 0.3s;
    }

    @@keyframes creditPulse {
        0% {
            background-color: rgba(220,38,38,0.06);
        }

        50% {
            background-color: rgba(220,38,38,0.16);
        }

        100% {
            background-color: rgba(220,38,38,0.06);
        }
    }

    .credit-row:hover {
        background-color: rgba(220,38,38,0.20);
    }

    /* Table spacing */
    table th, table td {
        vertical-align: middle;
        padding: 0.75rem;
    }

        table td.text-start {
            text-align: left;
        }

    /* Input + button alignment */
    .d-flex.gap-2 input,
    .d-flex.gap-2 button {
        vertical-align: middle;
    }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .d-flex.gap-2

    {
        flex-direction: column;
    }

    .d-flex.gap-2 input {
        width: 100% !important;
    }

    .d-flex.gap-2 button {
        width: 100% !important;
    }

    }
</style>
