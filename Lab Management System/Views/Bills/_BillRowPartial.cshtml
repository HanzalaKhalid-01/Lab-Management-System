@model Lab_Management_System.Models.Bill

<tr data-billid="@Model.BillId" class="@(Model.RemainingAmount > 0 ? "credit-row" : "")">
    <td class="fw-bold">@Model.BillNumber</td>
    <td>@Model.BillDate.ToString("dd-MM-yyyy")</td>
    <td>
        <div class="fw-bold">@Model.Patient.FullName</div>
        <small class="text-muted">@Model.Patient.PhoneNumber</small>
    </td>
    <td>@string.Join(", ", Model.BillItems.Select(x => x.TestNameSnapshot))</td>
    <td>Rs @(Model.TotalAmount - Model.DiscountAmount).ToString("N0")</td>
    <td>Rs @Model.PaidAmount.ToString("N0")</td>
    <td class="@(Model.RemainingAmount > 0 ? "status-credit" : "status-paid")">
        Rs @Model.RemainingAmount.ToString("N0")
        @(Model.RemainingAmount > 0 ? " ⚠️" : " ✅")
    </td>
    <td>
        @if (Model.RemainingAmount > 0)
        {
            <span class="badge bg-danger">Credit</span>
        }
        else
        {
            <span class="badge bg-success">Paid</span>
        }
    </td>
    <td>
        <a asp-action="Print" asp-route-id="@Model.BillId" target="_blank"
           class="btn btn-sm btn-outline-dark">🖨</a>
        @if (Model.RemainingAmount > 0)
        {
            <button class="btn btn-sm btn-outline-success"
                    onclick="openReceiveModal(@Model.PatientId)">
                ₹ Receive
            </button>
        }
    </td>
</tr>
