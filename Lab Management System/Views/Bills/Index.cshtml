@model IEnumerable<Lab_Management_System.Models.Bill>

@{
    ViewData["Title"] = "All Bills";
}

<div class="container-fluid mt-3">

    <h3 class="mb-3 fw-bold text-primary">All Bills</h3>

    <!-- Filters -->
    <div class="row mb-3 g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Search Patient</label>
            <input type="text" id="globalSearch" class="form-control"
                   placeholder="Search by patient name or phone">
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Status</label>
            <select id="statusFilter" class="form-select">
                <option value="">All</option>
                <option value="Paid">Paid</option>
                <option value="Credit">Credit</option>
            </select>
        </div>

        <div class="col-md-2">
            <button class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                Reset
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle text-center w-100" id="billsTable">

            <thead class="table-light">
                <tr>
                    <th>Bill No</th>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Phone</th>
                    <th>Tests</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Remaining</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var bill in Model)
                {
                    var isCredit = bill.RemainingAmount > 0;

                    <tr class="@(isCredit ? "credit-blink fw-semibold" : "")">
                        <td>@bill.BillMonth.ToString("D2")-@bill.BillNumber.ToString("D3")</td>
                        <td>@bill.BillDate.ToString("dd MMM yyyy")</td>
                        <td>@bill.Patient?.FullName</td>
                        <td>@bill.Patient?.PhoneNumber</td>

                        <td class="tests-col">
                            @(bill.BillItems != null && bill.BillItems.Any()
                                ? string.Join(", ", bill.BillItems.Select(x => x.TestNameSnapshot).Distinct())
                                : "—")
                        </td>

                        <td class="text-center">
                            Rs @(bill.TotalAmount - bill.DiscountAmount)
                        </td>

                        <td class="text-end">
                            Rs @bill.PaidAmount.ToString("N0")
                        </td>

                        <td class="text-end fw-bold @(isCredit ? "text-danger" : "text-success")">
                            Rs @bill.RemainingAmount.ToString("N0")
                        </td>

                        <td>
                            @if (isCredit)
                            {
                                <span class="badge bg-danger">Credit</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                        </td>

                        <!-- ACTIONS: PRINT + DELETE ONLY -->
                        <td>
                            <a asp-action="Print"
                               asp-route-id="@bill.BillId"
                               target="_blank"
                               class="btn btn-sm btn-outline-dark w-50">
                                Print
                            </a>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger w-50"
                                    onclick="if(confirm('Are you sure you want to delete this bill?')) { window.location='@Url.Action("Delete", "Bills", new { id = bill.BillId })'; }">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>


<style>
    /* Table spacing */
    table th, table td {
        padding: 0.9rem;
        vertical-align: middle;
        white-space: nowrap;
    }

    .tests-col {
        white-space: normal !important;
        min-width: 320px;
    }

    /* Light medical UI */
    #billsTable thead th {
        background-color: #f1f5f9;
        color: #0f172a;
        font-weight: 700;
        border-bottom: 2px solid #cbd5e1;
    }

    #billsTable tbody tr:hover {
        background-color: #f8fafc;
    }

    #billsTable td, #billsTable th {
        border-color: #e2e8f0;
    }

    /* ===============================
          CREDIT ROW – ALERT STYLE
       =============================== */

    table.dataTable tbody tr.credit-blink td:first-child,
    table.DTFC_Cloned tbody tr.credit-blink td:first-child {
        border-left: 6px solid #dc2626; /* solid alert red */
    }

    /* soft red breathing background */
    table.dataTable tbody tr.credit-blink td,
    table.DTFC_Cloned tbody tr.credit-blink td {
        background: rgba(220, 38, 38, 0.08);
        animation: creditAlert 1.6s ease-in-out infinite;
    }

    @@keyframes creditAlert {
        0% {
            background-color: rgba(220, 38, 38, 0.06);
        }

        50% {
            background-color: rgba(220, 38, 38, 0.18);
        }

        100% {
            background-color: rgba(220, 38, 38, 0.06);
        }
    }


    table.dataTable tbody tr.credit-blink td {
        position: relative;
        z-index: 2;
    }

</style>

@section Scripts {
    <script>
        let table;

        $(document).ready(function () {
            table = $('#billsTable').DataTable({
                dom: 'rtip',
                paging: true,
                pageLength: 25,
                ordering: true,
                info: false,
                autoWidth: false,
                scrollX: true,
                scrollY: '60vh',
                scrollCollapse: true,
                fixedHeader: true,
                fixedColumns: { rightColumns: 1 },

                columnDefs: [
                    { width: 80, targets: 0 },
                    { width: 140, targets: 1 },
                    { width: 180, targets: 2 },
                    { width: 130, targets: 3 },
                    { width: 350, targets: 4 },
                    { width: 110, targets: 5 },
                    { width: 110, targets: 6 },
                    { width: 120, targets: 7 },
                    { width: 110, targets: 8 },
                    { width: 130, targets: 9 }
                ]
            });

            $('#globalSearch').on('keyup', function () {
                table.search(this.value).draw();
            });

            $('#statusFilter').on('change', function () {
                table.draw();
            });

            $.fn.dataTable.ext.search.push(function (settings, data) {
                const selected = $('#statusFilter').val();
                if (!selected) return true;
                return data[8].includes(selected);
            });
        });

        function resetFilters() {
            $('#globalSearch').val('');
            $('#statusFilter').val('');
            table.search('').draw();
        }

    </script>
}
