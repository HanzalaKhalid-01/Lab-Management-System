@model IEnumerable<LabManagement.ViewModels.PatientCreditViewModel>

@{
    ViewData["Title"] = "Patient Credits";
}

<style>
    /* Page header */
    .page-header {
        margin-bottom: 1.5rem;
    }

    /* Card */
    .credit-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        padding: 20px;
    }

    /* Table styling */
    .credit-table th {
        background-color: #f8fafc;
        color: #1f2937;
        font-weight: 700;
        border-bottom: 2px solid #e5e7eb;
        text-align: center;
    }

    .credit-table td {
        vertical-align: middle;
        text-align: center;
    }

    /* Credit row alert */
    .credit-row {
        background-color: rgba(220, 38, 38, 0.08);
        border-left: 6px solid #dc2626;
        font-weight: 600;
        transition: background 0.3s;
    }

    .credit-row:hover {
        background-color: rgba(220, 38, 38, 0.12);
    }

    /* Patient link */
    .patient-link {
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
    }

    .patient-link:hover {
        text-decoration: underline;
    }

    /* Status badge */
    .status-badge {
        background-color: #dc2626;
        color: #fff;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Modal custom size */
    .custom-modal {
        max-width: 1400px; /* extra wide */
        width: 95%; /* nearly full width */
        height: 30vh; /* almost full screen height */
    }

        .custom-modal .modal-content {
            height: 30%;
        }

        .custom-modal .modal-body {
            overflow-y: auto;
            max-height: calc(30vh - 120px); /* leave room for header/footer */
        }

    /* Table responsive inside modal */
    .modal-body table {
        width: 100%;
    }
</style>

<div class="container-fluid mt-3">

    <div class="page-header">
        <h3 class="fw-bold text-danger mb-1">Patient Credit Dashboard</h3>
        <p class="text-muted mb-0">
            Overview of Patients with Remaining Balance
        </p>
    </div>

    <div class="credit-card">
        <table class="table credit-table table-hover table-bordered">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Phone</th>
                    <th>Total Bills</th>
                    <th>Total Credit (Rs)</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="credit-row">
                        <td>
                            <a href="#"
                               class="patient-link"
                               onclick="loadPatientBills(@item.PatientId, '@item.PatientName')">
                                @item.PatientName
                            </a>
                        </td>

                        <td>@item.PhoneNumber</td>
                        <td>@item.TotalBills</td>

                        <td class="text-danger fw-bold">
                            Rs @item.TotalCredit.ToString("N2")
                        </td>

                        <td>
                            <span class="status-badge">
                                ⚠ Pending
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Full dashboard modal -->
<div class="modal fade" id="creditModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pending Bills</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="creditModalBody">
                Loading...
            </div>
        </div>
    </div>
</div>

<script>
    function loadPatientBills(patientId, patientName) {
        document.querySelector('#creditModal .modal-title').innerText =
            'Pending Bills – ' + patientName;

        fetch(`/Bills/PatientUnpaidBillsPartial?patientId=${patientId}`)
            .then(res => res.text())
            .then(html => {
                document.getElementById('creditModalBody').innerHTML = html;

                // Show the modal
                new bootstrap.Modal(
                    document.getElementById('creditModal')
                ).show();
            });
    }

    function receivePayment(billId) {
        const input = document.getElementById('pay_' + billId);
        const amount = parseFloat(input.value);

        if (!amount || amount <= 0) {
            alert('Enter valid amount');
            return;
        }

        fetch('/Bills/ReceivePayment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ billId, amount })
        })
        .then(res => {
            if (!res.ok) return res.text().then(err => { throw err; });
            // Optional: reload modal content without closing
            location.reload();
        })
        .catch(err => alert(err));
    }
</script>
