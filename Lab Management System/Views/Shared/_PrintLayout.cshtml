<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Receipt</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            width: 58mm;
            font-family: monospace;
            font-size: 11px;
        }

        hr {
            border: none;
            border-top: 1px dashed #000;
            margin: 6px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 2px 0;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        @@media print {
            button {
                display: none;
            }
        }
    </style>
</head>
<body>
    @RenderBody()
    <script>
        window.onload = function () {
            window.print();
            setTimeout(() => {
            window.location.href = '@Url.Action("CreateFullBill", "Bills")';
        }, 500);
        };
    </script>
</body>
</html>
