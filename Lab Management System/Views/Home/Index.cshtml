@{
    ViewData["Title"] = "Welcome";
}

<style>
    body {
        background: linear-gradient(135deg, #f5f9ff, #e9f1ff);
    }

    .welcome-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .welcome-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 50px 40px;
        max-width: 900px;
        width: 100%;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
    }

    .welcome-title {
        font-size: 2.4rem;
        font-weight: 800;
        color: #0b3c5d;
        letter-spacing: 0.5px;
        margin-bottom: 15px;
    }

    .welcome-subtitle {
        font-size: 1.2rem;
        font-weight: 600;
        color: #1e88e5;
        margin-bottom: 25px;
    }

    .welcome-divider {
        width: 80px;
        height: 4px;
        background: #1e88e5;
        margin: 0 auto 30px;
        border-radius: 2px;
    }

    .welcome-info {
        font-size: 1.1rem;
        color: #444;
        line-height: 1.8;
        margin-bottom: 25px;
    }

    .welcome-contact {
        font-size: 1.15rem;
        font-weight: 600;
        color: #0b3c5d;
    }

        .welcome-contact a {
            color: #1e88e5;
            text-decoration: none;
        }

            .welcome-contact a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .welcome-title

    {
        font-size: 1.9rem;
    }

    }
</style>

<div class="welcome-wrapper">
    <div class="welcome-card">
        <div class="welcome-title">
            NEW AMERICAN DIAGNOSTIC CENTER
        </div>

        <div class="welcome-subtitle">
            Pathology Laboratory & Ultrasound Medical Center
        </div>

        <div class="welcome-divider"></div>

        <div class="welcome-info">
            Providing accurate diagnostics and compassionate care using
            advanced laboratory and imaging technologies.
        </div>

        <div class="welcome-info">
            📍 Latifabad, Hyderabad
        </div>

        <div class="welcome-contact">
            📞 <a href="tel:03332639947">0333-2639947</a>
        </div>
    </div>
</div>
